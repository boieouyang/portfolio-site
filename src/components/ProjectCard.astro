---
interface Props { project: any; feature?: boolean }
const { project, feature = false } = Astro.props;
const d = project.data;
---
<a class:list={['project-card', { feature }]} href={`/work/${project.id}`}>
  <div class="cover"><img src={d.cover} alt={d.coverAlt} loading={feature ? 'eager' : 'lazy'} /></div>
  {feature ? (
    <div class="text">
      <span class="ctx">{d.category} · {d.context}</span>
      <h3>{d.title}</h3>
      <p>{d.summary}</p>
    </div>
  ) : (
    <>
      <span class="ctx">{d.category} · {d.context}</span>
      <h3>{d.title}</h3>
      <p>{d.summary}</p>
    </>
  )}
</a>
