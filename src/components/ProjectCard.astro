---
import Cover from './Cover.astro';
interface Props { project: any; index?: number }
const { project, index = 0 } = Astro.props;
const d = project.data;
---
<a class="card" id={`c-${project.id}`} style={`view-transition-name:c-${project.id}`} data-s={(d.skills ?? []).join(' ')} data-t={(d.tools ?? []).join('|')} href={`/work/${project.id}`}>
  <Cover project={project} index={index} />
  <span class="mono">{d.category} · {d.context}</span>
  <h3>{d.title}</h3>
  <p>{d.summary}</p>
</a>
