---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: projects[(i + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const reflection = d.reflection ? await getEntry('reflections', d.reflection) : undefined;
---
<Base title={d.title} description={d.summary} image={d.cover} label="Project">
  <article class="page">
    <div class="wrap">
      <header class="page-head">
        <span class="mono">{d.category} · {d.context}</span>
        <h1>{d.title}</h1>
        <p class="summary">{d.summary}</p>
        {(d.role || d.timeline || d.team || d.tools) && (
          <dl class="meta">
            {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
            {d.timeline && <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>}
            {d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}
            {d.tools && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
          </dl>
        )}
        {d.highlights && <ul class="highlights">{d.highlights.map((h) => <li>{h}</li>)}</ul>}
      </header>
      <figure class="page-cover"><img src={d.cover} alt={d.coverAlt} /></figure>
      <div class="prose">
        {d.prototypes && (
          <>
            <h2 style="margin-top:0">{d.linksTitle ?? (d.prototypes.length === 1 ? 'Try the prototype' : 'Try the prototypes')}</h2>
            <ul class="prototypes">{d.prototypes.map((p) => <li><a href={p.url} target="_blank" rel="noopener">{p.label}</a></li>)}</ul>
          </>
        )}
        <Content />
        {reflection && <p><a href={`/writing/${reflection.id}`}>Read the full reflection: {reflection.data.title}</a></p>}
      </div>
    </div>
  </article>
  <nav class="related" aria-label="More projects">
    <div class="wrap">
      <a href="/#work"><span class="mono">Back to</span><strong>← Portfolio</strong></a>
      <a href={`/work/${next.id}`}><span class="mono">Next project</span><strong>{next.data.title} →</strong></a>
    </div>
  </nav>
</Base>
