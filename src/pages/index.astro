---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const reflections = (await getCollection('reflections', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [first, ...rest] = projects;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base navyHeader>
  <section class="hero" aria-label="Introduction">
    <div class="wrap">
      <div class="hero-text">
        <h1 aria-label="Baoyi Ouyang"><span class="line"><span>Baoyi</span></span><span class="line"><span>Ouyang</span></span></h1>
        <p class="lede">{site.intro}</p>
        <ul class="cities" aria-label="Places I've lived and learned">
          {site.cities.map((c, i) => <li style={`--i:${i}`}>{c}</li>)}
        </ul>
      </div>
      <figure class="hero-photo"><img src={site.heroImage} alt={site.heroAlt} fetchpriority="high" /></figure>
    </div>
  </section>

  <div class="wrap">
    <section class="section" id="work" aria-labelledby="work-h">
      <div class="section-head" data-reveal><h2 id="work-h">Portfolio</h2></div>
      <div class="work-grid">
        <ProjectCard project={first} feature />
        {rest.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-h">
      <div class="section-head" data-reveal><h2 id="about-h">About</h2></div>
      <div class="about-grid">
        <figure data-reveal><img src={site.aboutImage} alt={site.aboutAlt} loading="lazy" /></figure>
        <div class="about-text">
          {site.about.map((p, i) => <p data-reveal style={`--i:${i + 1}`}>{p}</p>)}
          <ul class="record">
            {site.experience.map((e, i) => (
              <li data-reveal style={`--i:${i}`}><span>{e.role}</span><span class="org">{e.org}</span><span class="years">{e.years}</span></li>
            ))}
          </ul>
          <div class="actions" data-reveal>
            <a class="btn solid" href={`mailto:${site.email}`}>Email me</a>
            {site.resume && <a class="btn" href={site.resume}>Download résumé</a>}
            {site.linkedin && <a class="btn" href={site.linkedin}>LinkedIn</a>}
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="skills-h">
      <div class="section-head" data-reveal>
        <h2 id="skills-h">What I do</h2>
        <p class="hint"><span class="hint-hover">Hover a skill to see the tools behind it</span><span class="hint-tap">Tap a skill to see the tools behind it</span></p>
      </div>
      <div class="skills">
        {site.skills.map((s, i) => (
          <div class="skill" data-reveal data-tools={s.tools.join('|')} style={`--i:${i % 3}`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.name}</h3><p>{s.text}</p>
          </div>
        ))}
      </div>
      <ul class="tools" aria-label="Tools" data-reveal>{site.tools.map((t, i) => <li data-tool={t} style={`--i:${i}`}>{t}</li>)}</ul>
    </section>

    <section class="section" aria-labelledby="writing-h">
      <div class="section-head" data-reveal><h2 id="writing-h">Learning Reflections</h2><a href="/writing">All reflections</a></div>
      <ul class="writing-list">
        {reflections.slice(0, 3).map((r, i) => (
          <li data-reveal style={`--i:${i}`}><a href={`/writing/${r.id}`}>
            <div class="thumb" style={`view-transition-name: thumb-${r.id}`}><img src={r.data.cover} alt="" loading="lazy" /></div>
            <div><p class="meta">{r.data.course} · {fmt(r.data.date)}</p><h3><span class="u">{r.data.title}</span></h3><p>{r.data.summary}</p></div>
          </a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  // What I do: pointing at a skill lights up the tools behind it, and pointing at a tool lights up its skills
  const skills = document.querySelector('.skills');
  const tools = document.querySelector('.tools');
  if (skills && tools) {
    const items = [...skills.querySelectorAll<HTMLElement>('.skill')];
    const chips = [...tools.querySelectorAll<HTMLElement>('li')];
    const toolsOf = (item: HTMLElement) => (item.dataset.tools ? item.dataset.tools.split('|') : []);
    const clear = () => {
      skills.classList.remove('has-active');
      tools.classList.remove('has-active');
      items.forEach((i) => i.classList.remove('is-active'));
      chips.forEach((c) => c.classList.remove('is-match'));
    };
    const activate = (active: HTMLElement[], matches: HTMLElement[]) => {
      clear();
      skills.classList.toggle('has-active', active.length > 0);
      tools.classList.toggle('has-active', matches.length > 0);
      active.forEach((i) => i.classList.add('is-active'));
      matches.forEach((c) => c.classList.add('is-match'));
    };
    const fromSkill = (item: HTMLElement) => activate([item], chips.filter((c) => toolsOf(item).includes(c.dataset.tool!)));
    const fromTool = (chip: HTMLElement) => activate(items.filter((i) => toolsOf(i).includes(chip.dataset.tool!)), [chip]);
    const bind = (el: HTMLElement, on: () => void) => {
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') on(); });
      el.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') clear(); });
      // Touch and pen: tap to toggle
      el.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') return;
        el.classList.contains('is-active') || el.classList.contains('is-match') ? clear() : on();
      });
    };
    items.forEach((item) => bind(item, () => fromSkill(item)));
    chips.forEach((chip) => bind(chip, () => fromTool(chip)));
  }
</script>
