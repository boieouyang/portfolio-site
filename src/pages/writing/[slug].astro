---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('reflections', ({ data }) => !data.draft);
  return items.map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const d = r.data;
const { Content } = await render(r);
const date = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.summary} image={d.cover} current="writing">
  <article>
    <div class="wrap">
      <header class="page-head">
        <p class="ctx">{d.course} · <time datetime={d.date.toISOString().slice(0, 10)}>{date}</time></p>
        <h1>{d.title}</h1>
        <p class="summary">{d.summary}</p>
      </header>
      <figure class="page-cover"><img src={d.cover} alt={d.coverAlt} /></figure>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <nav class="related" aria-label="More writing">
    <div class="wrap"><a href="/writing"><span>Back to</span><strong>All writing</strong></a><a href="/#work"><span>See</span><strong>Selected work</strong></a></div>
  </nav>
</Base>
