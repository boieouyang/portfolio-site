---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('reflections', ({ data }) => !data.draft);
  return items.map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const d = r.data;
const { Content } = await render(r);
const date = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.summary} image={d.cover} label="Reflection">
  <article class="page">
    <div class="wrap">
      <header class="page-head">
        <span class="mono">{d.course} · <time datetime={d.date.toISOString().slice(0, 10)}>{date}</time></span>
        <h1>{d.title}</h1>
        <p class="summary">{d.summary}</p>
      </header>
      <figure class="page-cover"><img src={d.cover} alt={d.coverAlt} /></figure>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <nav class="related" aria-label="More reflections">
    <div class="wrap">
      <a href="/writing"><span class="mono">Back to</span><strong>← Learning Reflections</strong></a>
      <a href="/#work"><span class="mono">See</span><strong>Portfolio →</strong></a>
    </div>
  </nav>
</Base>
